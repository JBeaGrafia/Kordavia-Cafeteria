# Email donde llegarán los mensajes del formulario
CONTACT_EMAIL=tu-cliente@email.com

# API key de Resend (https://resend.com) — necesaria para enviar emails en Vercel
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente (debe estar verificado en Resend; en pruebas: onboarding@resend.dev)
FROM_EMAIL=De Barrio <onboarding@resend.dev>

# Opcional: permite ?to=email en la URL para demos (no usar en producción abierta)
ALLOW_EMAIL_OVERRIDE=false
